<style>
#internships {
  padding: 25px;
  text-align: center;
  font-family: Arial, sans-serif;
  background: #f0f7ff;
}

.internship-card {
  background: white;
  padding: 18px;
  margin: 15px auto;
  max-width: 450px;
  border-radius: 12px;
  box-shadow: 0 2px 8px #cccccc;
}

.internship-card a {
  display: inline-block;
  background: #1769e0;
  color: white;
  padding: 10px 16px;
  border-radius: 6px;
  text-decoration: none;
}
</style>
<!-- Company Internship Form -->
<section id="company-form">
  <h2>Company: Post an Internship</h2>
  <p>Hire talented students with Skill Bridge</p>

  <form id="internForm">
    <input type="text" id="company"
      placeholder="Company Name" required>

    <input type="text" id="role"
      placeholder="Internship Role" required>

    <select id="qualification" required>
      <option value="">Select Qualification</option>
      <option>Diploma</option>
      <option>B.Tech</option>
      <option>BCA</option>
      <option>B.Com</option>
      <option>Class 10 / 12</option>
    </select>

    <select id="mode" required>
      <option value="">Select Work Mode</option>
      <option>Online / Remote</option>
      <option>Work from Office</option>
      <option>Hybrid</option>
    </select>

    <input type="number" id="seats"
      placeholder="Number of Seats" min="1" required>

    <input type="url" id="applyLink"
      placeholder="Application Link (https://...)" required>

    <button type="submit">Preview Internship</button>
  </form>

  <div id="preview"></div>
</section>

<style>
#company-form {
  background: #eef5ff;
  padding: 25px 15px;
  text-align: center;
  font-family: Arial, sans-serif;
}

#internForm {
  max-width: 420px;
  margin: auto;
}

#internForm input,
#internForm select {
  box-sizing: border-box;
  width: 100%;
  padding: 12px;
  margin: 8px 0;
  border: 1px solid #bbb;
  border-radius: 7px;
  background: white;
}

#internForm button {
  padding: 12px 20px;
  background: #1769e0;
  color: white;
  border: 0;
  border-radius: 7px;
  cursor: pointer;
}

#preview {
  max-width: 420px;
  margin: 15px auto;
  overflow-wrap: anywhere;
}
</style>

<script>
document.getElementById("internForm")
.addEventListener("submit", function(event) {
  event.preventDefault();

  const company = document.getElementById("company").value;
  const role = document.getElementById("role").value;
  const qualification =
    document.getElementById("qualification").value;
  const mode = document.getElementById("mode").value;
  const seats = document.getElementById("seats").value;
  const link = document.getElementById("applyLink").value;

  const preview = document.getElementById("preview");
  preview.replaceChildren();

  const card = document.createElement("div");
  card.className = "internship-card";

  const details = [
    company,
    role,
    "Qualification: " + qualification,
    "Work Mode: " + mode,
    "Seats: " + seats
  ];

  details.forEach(function(detail) {
    const p = document.createElement("p");
    p.textContent = detail;
    card.appendChild(p);
  });

  const a = document.createElement("a");
  a.href = link;
  a.target = "_blank";
  a.rel = "noopener noreferrer";
  a.textContent = "Apply Now";
  card.appendChild(a);

  preview.appendChild(card);
});
</script><!-- Company Job and Internship Section -->
